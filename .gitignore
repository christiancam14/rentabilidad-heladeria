# --- PHP / Laravel ---
/.phpunit.cache
.phpunit.result.cache
.phpactor.json
/auth.json
/vendor
/bootstrap/ssr

# --- Entorno (configurar en panel Hostinger, no en Git) ---
.env
.env.backup
.env.production

# --- Node (instalar solo en desarrollo; build sí va al repo) ---
/node_modules
npm-debug.log
yarn-error.log

# --- Vite / frontend ---
# public/build SÍ se sube (Hostinger suele no tener Node en el servidor)
/public/hot

# Generados por Wayfinder en local (se incluyen en public/build al hacer npm run build)
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# --- Storage / runtime (no subir datos de sesión, caché ni logs) ---
/storage/*.key
/storage/pail
/public/storage

# --- IDE / OS ---
.DS_Store
/.fleet
/.idea
/.nova
/.vscode
/.zed
Homestead.json
Homestead.yaml
